<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | ProductPro</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="auth-body">

    <div class="auth-container">
        <div class="auth-card glass-panel">
            <div class="auth-header">
                <i class="fas fa-cube icon-glow"></i>
                <h2>Welcome Back</h2>
                <p>Sign in to access your dashboard</p>
            </div>

            <% if (error) { %>
                <div class="alert-error">
                    <i class="fas fa-exclamation-triangle"></i>
                    <%= error %>
                </div>
                <% } %>

                    <form action="/login" method="POST" class="auth-form">
                        <div class="input-group">
                            <i class="fas fa-user"></i>
                            <input type="text" name="username" placeholder="Username" required>
                        </div>
                        <div class="input-group">
                            <i class="fas fa-key"></i>
                            <input type="password" name="password" placeholder="Password" required>
                        </div>

                        <button type="submit" class="btn-glow btn-block">Login</button>
                    </form>

                    <div class="auth-footer">
                        <p>New here? <a href="/register" class="link-glow">Create Account</a></p>
                        <div style="margin-top: 10px; font-size: 0.8em; color: rgba(255,255,255,0.3);">
                            Default: admin / admin
                        </div>
                    </div>
        </div>
    </div>

</body>

</html>