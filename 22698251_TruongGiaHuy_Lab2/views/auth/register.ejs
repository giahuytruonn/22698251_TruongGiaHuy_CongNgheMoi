<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Join Us</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body class="auth-body">

    <div class="auth-container">
        <div class="auth-card glass-panel">
            <div class="auth-header">
                <i class="fas fa-user-plus icon-glow"></i>
                <h2>Create Account</h2>
                <p>Join our premium platform</p>
            </div>

            <% if (error) { %>
                <div class="alert-error">
                    <i class="fas fa-exclamation-circle"></i>
                    <%= error %>
                </div>
                <% } %>

                    <form action="/register" method="POST" class="auth-form">
                        <div class="input-group">
                            <i class="fas fa-user"></i>
                            <input type="text" name="username" placeholder="Username" required>
                        </div>
                        <div class="input-group">
                            <i class="fas fa-lock"></i>
                            <input type="password" name="password" placeholder="Password" required>
                        </div>

                        <button type="submit" class="btn-glow btn-block">Sign Up</button>
                    </form>

                    <div class="auth-footer">
                        <p>Already have an account? <a href="/login" class="link-glow">Login here</a></p>
                    </div>
        </div>
    </div>

</body>

</html>