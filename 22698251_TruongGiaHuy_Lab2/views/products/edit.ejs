<div class="page-header" style="justify-content: center;">
    <h1>Edit Product</h1>
</div>

<div class="form-card">
    <form action="/products/<%= product.id %>/update" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label for="name">Product Name</label>
            <input type="text" id="name" name="name" class="form-control" required value="<%= product.name %>">
        </div>

        <div class="form-group">
            <label for="categoryId">Category</label>
            <select id="categoryId" name="categoryId" class="form-control" required>
                <option value="">Select Category</option>
                <% if(typeof categories !=='undefined' ) { %>
                    <% categories.forEach(cat=> { %>
                        <option value="<%= cat.categoryId %>" <%=product.categoryId===cat.categoryId ? 'selected' : ''
                            %>><%= cat.name %>
                        </option>
                        <% }) %>
                            <% } %>
            </select>
        </div>

        <div class="form-group">
            <label for="price">Price ($)</label>
            <input type="number" id="price" name="price" class="form-control" required min="0" step="0.01"
                value="<%= product.price %>">
        </div>

        <div class="form-group">
            <label for="quantity">Stock Quantity</label>
            <input type="number" id="quantity" name="quantity" class="form-control" required min="0"
                value="<%= product.quantity %>">
        </div>

        <div class="form-group">
            <label>Current Image</label>
            <% if (product.url_image) { %>
                <div style="margin-bottom: 10px;">
                    <img src="<%= product.url_image %>" alt="Current" style="height: 100px; border-radius: 8px;">
                </div>
                <% } else { %>
                    <p>No image uploaded.</p>
                    <% } %>

                        <label for="image">Change Image</label>
                        <input type="file" id="image" name="image" class="form-control">
        </div>

        <div style="margin-top: 2rem; display: flex; gap: 1rem;">
            <a href="/products" class="btn btn-secondary" style="flex: 1;">Cancel</a>
            <button type="submit" class="btn btn-primary" style="flex: 2;">
                <i class="fas fa-save"></i> Update Product
            </button>
        </div>
    </form>
</div>