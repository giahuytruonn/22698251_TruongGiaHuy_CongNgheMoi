<div class="product-list-container">
    <div class="header-actions">
        <h2>Our Products</h2>

        <!-- Search & Filter Form -->
        <form action="/products" method="GET" class="card p-3 mb-4 bg-light">
            <div class="row g-2">
                <div class="col-md-3">
                    <input type="text" name="name" class="form-control" placeholder="Search by name..."
                        value="<%= typeof filters !== 'undefined' ? filters.name : '' %>">
                </div>
                <div class="col-md-3">
                    <select name="categoryId" class="form-select">
                        <option value="">All Categories</option>
                        <% if(typeof categories !=='undefined' && categories.length> 0) { %>
                            <% categories.forEach(cat=> { %>
                                <option value="<%= cat.categoryId %>" <%=typeof filters !=='undefined' &&
                                    filters.categoryId==cat.categoryId ? 'selected' : '' %>><%= cat.name %>
                                </option>
                                <% }) %>
                                    <% } %>
                    </select>
                </div>
                <div class="col-md-2">
                    <input type="number" name="minPrice" class="form-control" placeholder="Min Price"
                        value="<%= typeof filters !== 'undefined' ? filters.minPrice : '' %>">
                </div>
                <div class="col-md-2">
                    <input type="number" name="maxPrice" class="form-control" placeholder="Max Price"
                        value="<%= typeof filters !== 'undefined' ? filters.maxPrice : '' %>">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">Filter</button>
                </div>
            </div>
        </form>
    </div>

    <div class="product-grid">
        <% if (products.length> 0) { %>
            <% products.forEach(product=> { %>
                <div class="product-card">
                    <div class="product-image">
                        <% if (product.url_image) { %>
                            <img src="<%= product.url_image %>" alt="<%= product.name %>">
                            <% } else { %>
                                <div class="no-image">
                                    <i class="fas fa-image"></i>
                                    <span>No Image</span>
                                </div>
                                <% } %>
                    </div>
                    <div class="product-info">
                        <h3>
                            <%= product.name %>
                        </h3>

                        <!-- Inventory Logic -->
                        <% if (product.quantity===0) { %>
                            <span class="badge bg-danger">Out of Stock</span>
                            <% } else if (product.quantity < 5) { %>
                                <span class="badge bg-warning text-dark">Low Stock (<%= product.quantity %>)</span>
                                <% } else { %>
                                    <span class="badge bg-success">In Stock</span>
                                    <% } %>

                                        <p class="price">$<%= product.price %>
                                        </p>

                                        <% if (user && user.role==='admin' ) { %>
                                            <div class="actions">
                                                <a href="/products/<%= product.id %>/edit" class="btn-edit">
                                                    <i class="fas fa-edit"></i> Edit
                                                </a>
                                                <form action="/products/<%= product.id %>/delete" method="POST"
                                                    onsubmit="return confirm('Are you sure you want to delete this product?');">
                                                    <button type="submit" class="btn-delete">
                                                        <i class="fas fa-trash"></i> Delete
                                                    </button>
                                                </form>
                                            </div>
                                            <% } %>
                    </div>
                </div>
                <% }); %>
                    <% } else { %>
                        <div class="no-products">
                            <i class="fas fa-box-open"></i>
                            <p>No products found matching your criteria.</p>
                            <a href="/products" class="btn-primary">Clear Filters</a>
                        </div>
                        <% } %>
    </div>
</div>