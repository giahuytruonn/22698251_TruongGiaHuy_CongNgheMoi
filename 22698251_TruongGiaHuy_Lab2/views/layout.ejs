<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Manager Pro</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>

<body>
    <div class="background-glow"></div>

    <!-- Navbar -->
    <nav class="navbar">
        <div class="container">
            <div class="logo">
                <i class="fas fa-cube icon-glow-small"></i> ProductPro
            </div>
            <div class="nav-links">
                <a href="/products" class="<%= typeof path !== 'undefined' && path === '/products' ? 'active' : '' %>">
                    <i class="fas fa-box"></i> Products
                </a>

                <% if (user) { %>
                    <% if (user.role==='admin' ) { %>
                        <a href="/products/create"
                            class="<%= typeof path !== 'undefined' && path === '/products/create' ? 'active' : '' %>">
                            <i class="fas fa-plus"></i> New Product
                        </a>
                        <a href="/categories"
                            class="<%= typeof path !== 'undefined' && path === '/categories' ? 'active' : '' %>">
                            <i class="fas fa-tags"></i> Categories
                        </a>
                        <% } %>

                            <span class="user-greeting">Hi, <%= user.username %></span>
                            <a href="/logout" class="btn-logout"><i class="fas fa-sign-out-alt"></i> Logout</a>
                            <% } else { %>
                                <a href="/login">Login</a>
                                <a href="/register" class="btn-primary-sm">Register</a>
                                <% } %>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container fade-in">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> ProductPro. Enhanced with Node.js & DynamoDB.</p>
        </div>
    </footer>

</body>

</html>