<%- include('./partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-10">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb bg-white p-3 rounded shadow-sm">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page"><%= product.name %></li>
            </ol>
        </nav>

        <div class="card border-0 shadow-sm mt-3 overflow-hidden">
            <div class="row g-0">
                <div class="col-md-5 p-4 d-flex align-items-center justify-content-center bg-light">
                    <img src="<%= product.url_image %>" class="img-fluid rounded shadow" alt="<%= product.name %>" style="max-height: 400px; object-fit: contain;">
                </div>
                <div class="col-md-7">
                    <div class="card-body p-5">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <h2 class="card-title fw-bold text-dark mb-0"><%= product.name %></h2>
                            <span class="badge bg-primary fs-5 px-3 py-2">$<%= product.price %></span>
                        </div>
                        
                        <p class="text-muted small mb-4">Product ID: <%= product.id %></p>
                        
                        <div class="mb-4">
                            <h6 class="text-uppercase text-secondary fw-bold mb-2">Availability</h6>
                            <% if (product.unit_in_stock > 10) { %>
                                <div class="d-flex align-items-center text-success fs-5">
                                    <i class="bi bi-check-circle-fill me-2"></i> 
                                    <span>In Stock (<%= product.unit_in_stock %> units)</span>
                                </div>
                            <% } else if (product.unit_in_stock > 0) { %>
                                <div class="d-flex align-items-center text-warning fs-5">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i> 
                                    <span>Low Stock (<%= product.unit_in_stock %> units left)</span>
                                </div>
                            <% } else { %>
                                <div class="d-flex align-items-center text-danger fs-5">
                                    <i class="bi bi-x-circle-fill me-2"></i> 
                                    <span>Out of Stock</span>
                                </div>
                            <% } %>
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex mt-5">
                            <a href="/edit/<%= product.id %>" class="btn btn-primary btn-lg px-4 me-md-2 shadow-sm">
                                <i class="bi bi-pencil me-2"></i>Edit Product
                            </a>
                            <form action="/delete/<%= product.id %>" method="POST" class="d-inline m-0 p-0" onsubmit="return confirm('Are you sure you want to delete <%= product.name %>?');">
                                <button type="submit" class="btn btn-outline-danger btn-lg px-4 w-100 h-100">
                                    <i class="bi bi-trash me-2"></i>Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
