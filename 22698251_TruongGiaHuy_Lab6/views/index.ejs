<%- include('./partials/header') %>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold m-0 text-dark">Products List</h2>
    <form action="/" method="GET" class="d-flex" style="width: 300px;">
        <div class="input-group shadow-sm">
            <input type="text" class="form-control border-end-0" placeholder="Search by name..." name="q" value="<%= searchQuery || '' %>">
            <button class="btn btn-white border border-start-0 text-primary bg-white" type="submit"><i class="bi bi-search"></i></button>
        </div>
    </form>
</div>

<div class="card p-0 overflow-hidden shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="text-secondary bg-light">
                <tr>
                    <th class="px-4 py-3">Image</th>
                    <th class="py-3">Name</th>
                    <th class="py-3">Price</th>
                    <th class="py-3 text-center">In Stock</th>
                    <th class="px-4 py-3 text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (products && products.length > 0) { %>
                    <% products.forEach(product => { %>
                        <tr>
                            <td class="px-4 py-3">
                                <img src="<%= product.url_image %>" alt="<%= product.name %>" class="product-img border">
                            </td>
                            <td class="py-3 fw-semibold text-dark fs-5"><%= product.name %></td>
                            <td class="py-3 text-primary fw-bold">$<%= product.price %></td>
                            <td class="py-3 text-center">
                                <span class="badge <%= product.unit_in_stock > 10 ? 'bg-success' : (product.unit_in_stock > 0 ? 'bg-warning text-dark' : 'bg-danger') %> rounded-pill px-3 py-2">
                                    <%= product.unit_in_stock %>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-end">
                                <a href="/product/<%= product.id %>" class="btn btn-sm btn-outline-info me-1" title="View Details"><i class="bi bi-eye"></i> View</a>
                                <a href="/edit/<%= product.id %>" class="btn btn-sm btn-outline-primary me-1" title="Edit Product"><i class="bi bi-pencil"></i> Edit</a>
                                <form action="/delete/<%= product.id %>" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete <%= product.name %>?');">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Product"><i class="bi bi-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3 text-secondary"></i>
                            <h5 class="fw-normal">No products found.</h5>
                            <% if(searchQuery) { %>
                                <p>Try another search term.</p>
                                <a href="/" class="btn btn-primary mt-2">Clear Search</a>
                            <% } else { %>
                                <p>Click 'Add Product' to get started!</p>
                            <% } %>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<%- include('./partials/footer') %>
