<%- include('./partials/header') %>

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-white border-bottom py-3">
                <h4 class="mb-0 text-primary fw-bold"><i class="bi bi-plus-circle me-2"></i>Add New Product</h4>
            </div>
            <div class="card-body p-4">
                <form action="/add" method="POST" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="name" class="form-label fw-semibold">Product Name</label>
                        <input type="text" class="form-control form-control-lg" id="name" name="name" required placeholder="Enter product name">
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="price" class="form-label fw-semibold">Price ($)</label>
                            <input type="number" step="0.01" min="0" class="form-control form-control-lg" id="price" name="price" required placeholder="0.00">
                        </div>
                        <div class="col-md-6">
                            <label for="unit_in_stock" class="form-label fw-semibold">Units in Stock</label>
                            <input type="number" min="0" class="form-control form-control-lg" id="unit_in_stock" name="unit_in_stock" required placeholder="0">
                        </div>
                    </div>

                    <div class="mb-4">
                        <label for="image" class="form-label fw-semibold">Product Image</label>
                        <input class="form-control" type="file" id="image" name="image" accept="image/*" onchange="previewImage(event)">
                        <div class="mt-2 text-center">
                            <img id="imagePreview" class="upload-preview" src="#" alt="Image Preview" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a href="/" class="btn btn-outline-secondary btn-lg px-4"><i class="bi bi-arrow-left me-2"></i>Back</a>
                        <button type="submit" class="btn btn-primary btn-lg px-5 shadow-sm"><i class="bi bi-check-circle me-2"></i>Save Product</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
