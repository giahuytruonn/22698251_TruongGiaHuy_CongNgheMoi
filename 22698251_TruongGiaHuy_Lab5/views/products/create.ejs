<%- include("../partials/header") %>

<div class="card">
  <div class="card-header">
    <h2>Create Product</h2>
    <p>Add product details and upload an image.</p>
  </div>
  <form class="form" method="POST" action="/products" enctype="multipart/form-data">
    <div class="form-grid">
      <label>
        Name
        <input type="text" name="name" placeholder="Product name" required />
      </label>
      <label>
        Price
        <input type="number" step="0.01" name="price" placeholder="0.00" required />
      </label>
      <label class="full">
        Image URL (optional)
        <input type="text" name="url_image" placeholder="https://example.com/image.png" />
      </label>
      <label class="full">
        Upload Image
        <input type="file" name="image" accept="image/*" />
      </label>
    </div>
    <div class="form-actions">
      <button class="button" type="submit">Save</button>
      <a class="button ghost" href="/products">Cancel</a>
    </div>
  </form>
</div>

<%- include("../partials/footer") %>

